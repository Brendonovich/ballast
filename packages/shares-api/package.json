{
  "name": "@ballast/shares-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.11.1"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "test": "vitest run",
    "dev": "BALLAST_SHARES_DEV_PORT=${BALLAST_SHARES_DEV_PORT:-1350} alchemy dev",
    "deploy": "alchemy deploy",
    "bridge": "pnpm dlx wrangler@4.168.0 dev -c scripts/shares-dev/wrangler.jsonc --ip 127.0.0.1 --port 8799 --persist-to .wrangler/shares"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@ballast/cloud-protocol": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
