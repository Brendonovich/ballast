{
  "name": "@ballast/agent",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "ballast": "./src/bin.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "test": "vitest run",
    "serve": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/bin.ts serve",
    "build:service": "node scripts/build-service.mjs"
  },
  "dependencies": {
    "@ballast/agent-protocol": "workspace:*",
    "@ballast/cloud-protocol": "workspace:*",
    "@ballast/mcp": "workspace:*",
    "@ballast/core": "workspace:*",
    "@ballast/fake": "workspace:*",
    "@ballast/module-obs": "workspace:*",
    "@ballast/module-twitch": "workspace:*",
    "@ballast/planner": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "rolldown": "catalog:",
    "ws": "catalog:",
    "@ballast/module-vtube-studio": "workspace:*",
    "@ballast/module-keyboard": "workspace:*",
    "@ballast/module-midi": "workspace:*",
    "@ballast/module-websocket": "workspace:*",
    "@ballast/module-http": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "vitest": "catalog:"
  }
}
