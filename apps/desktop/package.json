{
  "name": "@ballast/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ballast desktop shell: window, tray, service launcher and updater",
  "author": "Ballast",
  "type": "module",
  "main": "./out/main/index.js",
  "exports": {
    ".": "./src/main/index.ts",
    "./bridge": "./src/bridge.ts"
  },
  "scripts": {
    "dev": "node script/dev.mjs",
    "build": "node script/build.mjs",
    "prepare:service": "node script/prepare-service.mjs",
    "typecheck": "tsgo -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack": "node script/pack.mjs",
    "pack:installer": "node script/pack.mjs --installer"
  },
  "dependencies": {
    "@ballast/agent-protocol": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:",
    "vitest": "catalog:"
  }
}
