# Local development only. Never commit real secrets.
BALLAST_PUBLIC_ORIGIN=http://localhost:1338
TWITCH_CLIENT_ID=your-twitch-app-client-id
TWITCH_CLIENT_SECRET=your-twitch-app-client-secret
# 32 bytes, base64url or 64 hex characters. Generate with: openssl rand -base64 32
BALLAST_TOKEN_KEY=replace-me-with-32-random-bytes-base64url
BALLAST_TOKEN_PEPPER=replace-with-a-random-local-pepper
# Optional overrides for tests/miniflare:
# TWITCH_ID_BASE_URL=http://localhost:4010
# TWITCH_API_BASE_URL=http://localhost:4010
