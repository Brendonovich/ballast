{
  "name": "@ballast/cloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/worker.ts",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.11.1"
  },
  "exports": {
    ".": "./src/worker.ts"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "test": "vitest run",
    "alchemy": "node --experimental-transform-types --no-warnings=ExperimentalWarning --env-file-if-exists=.dev.vars --env-file-if-exists=.env node_modules/alchemy/bin/alchemy.js",
    "dev": "pnpm dev:remote",
    "dev:remote": "node scripts/dev-remote.mjs",
    "dev:local": "pnpm alchemy dev",
    "demo": "node scripts/local-demo.mjs",
    "shares:bridge": "pnpm --filter @ballast/shares-api bridge",
    "deploy": "pnpm alchemy deploy"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@ballast/cloud-protocol": "workspace:*",
    "@ballast/module-twitch": "workspace:*",
    "@ballast/shares-api": "workspace:*",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "vitest": "catalog:",
    "ws": "^8.23.0"
  }
}
