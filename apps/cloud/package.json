{
  "name": "@ballast/cloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/worker.ts",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.11.1"
  },
  "exports": {
    ".": "./src/worker.ts"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "test": "vitest run",
    "dev": "BALLAST_CLOUD_REMOTE_DEV=1 alchemy dev --stage ${BALLAST_CLOUD_STAGE:-dev-$USER}",
    "dev:local": "alchemy dev",
    "demo": "node scripts/local-demo.mjs",
    "shares:bridge": "pnpm --filter @ballast/shares-api bridge",
    "deploy": "alchemy deploy"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@ballast/cloud-protocol": "workspace:*",
    "@ballast/module-twitch": "workspace:*",
    "@ballast/shares-api": "workspace:*",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oauth4webapi": "3.8.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "vitest": "catalog:",
    "ws": "^8.23.0"
  }
}
